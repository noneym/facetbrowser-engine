 namespace net {
 
+namespace {
+
+// FacetBrowser: credentials for SOCKS5 username/password authentication.
+// They are written into the proxy switch, percent-encoded:
+//   --proxy-server=socks5://user:pass@host:port
+// The switch is forwarded to the network service for this purpose.
+struct Socks5Credentials {
+  std::string username;
+  std::string password;
+};
+
+using Socks5CredentialsMap = std::map<std::string, Socks5Credentials>;
+
+// Maps "host:port" of each SOCKS5 proxy in --proxy-server that has
+// credentials to those credentials.
+Socks5CredentialsMap ParseSocks5CredentialsFromCommandLine() {
+  Socks5CredentialsMap result;
+  const std::string rules =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "proxy-server");
+  for (std::string_view entry : base::SplitStringPiece(
+           rules, ";,", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    size_t scheme_end = entry.find("://");
+    if (scheme_end == std::string_view::npos) {
+      continue;
+    }
+    // Per-scheme rules look like "https=socks5://user:pass@host:port".
+    const size_t equals = entry.find('=');
+    if (equals != std::string_view::npos && equals < scheme_end) {
+      entry.remove_prefix(equals + 1);
+      scheme_end = entry.find("://");
+      if (scheme_end == std::string_view::npos) {
+        continue;
+      }
+    }
+    const std::string scheme = base::ToLowerASCII(entry.substr(0, scheme_end));
+    if (scheme != "socks5" && scheme != "socks") {
+      continue;
+    }
+    std::string_view authority = entry.substr(scheme_end + 3);
+    while (!authority.empty() && authority.back() == '/') {
+      authority.remove_suffix(1);
+    }
+    const size_t at = authority.rfind('@');
+    if (at == std::string_view::npos) {
+      continue;
+    }
+    const std::string_view userinfo = authority.substr(0, at);
+    const std::string host_and_port(authority.substr(at + 1));
+    HostPortPair proxy = HostPortPair::FromString(host_and_port);
+    if (proxy.IsEmpty()) {
+      // No port given; SOCKS proxies default to 1080.
+      proxy = HostPortPair::FromString(host_and_port + ":1080");
+    }
+    if (proxy.IsEmpty()) {
+      continue;
+    }
+    const size_t colon = userinfo.find(':');
+    Socks5Credentials credentials;
+    credentials.username =
+        base::UnescapeBinaryURLComponent(userinfo.substr(0, colon));
+    if (colon != std::string_view::npos) {
+      credentials.password =
+          base::UnescapeBinaryURLComponent(userinfo.substr(colon + 1));
+    }
+    result[base::ToLowerASCII(proxy.ToString())] = std::move(credentials);
+  }
+  return result;
+}
+
+const Socks5Credentials* FindSocks5Credentials(
+    const TransportSocketParams::Endpoint& endpoint) {
+  static const base::NoDestructor<Socks5CredentialsMap> credentials(
+      ParseSocks5CredentialsFromCommandLine());
+  if (credentials->empty()) {
+    return nullptr;
+  }
+  const HostPortPair proxy =
+      std::holds_alternative<HostPortPair>(endpoint)
+          ? std::get<HostPortPair>(endpoint)
+          : HostPortPair::FromSchemeHostPort(
+                std::get<url::SchemeHostPort>(endpoint));
+  const auto it = credentials->find(base::ToLowerASCII(proxy.ToString()));
+  return it == credentials->end() ? nullptr : &it->second;
+}
